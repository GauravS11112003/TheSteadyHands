  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">SteadyHandsCrossSectionController – 3x skin cross-section + practice needle</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">References</span>"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input SceneObject foldRoot {"hint":"Authored child that holds the diagram; enabled while shown"}'
    - '// @input SceneObject practiceNeedle {"hint":"Authored practice needle (gets the 2 cm grab-zone collider + Interactable)"}'
    - '// @input AssignableType_1 labels {"hint":"Labels UI module for this cross-section"}'
    - '// @input Asset.Material tissueMaterial {"hint":"XS_TissueTex: Uber Unlit, vertex colour = Base Color, base texture on (cloned per layer)"}'
    - '// @input Asset.Material vertexColorMaterial {"hint":"XS_VertexColor: Uber Unlit, vertex colour = Base Color, no texture (glows, chrome, details)"}'
    - '// @input Asset.Material unlitMaterial {"hint":"Fallback unlit material (SH_Unlit), used only if the XSection materials are missing"}'
    - '// @input Asset.Texture skinTexture {"hint":"Skin surface detail texture (epidermis)"}'
    - '// @input Asset.Texture dermisTexture {"hint":"Dermis collagen detail texture"}'
    - '// @input Asset.Texture fatTexture {"hint":"Fat lobule detail texture"}'
    - '// @input Asset.Texture muscleTexture {"hint":"Muscle striation detail texture"}'
    - '// @input SceneObject woundAnchor {"hint":"The pad (SuturePad): the projection link drops to its top centre"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float viewScale = 3 {"hint":"Drawing scale of the cross-section (brief: 3x real size)", "widget":"slider", "min":1, "max":6, "step":0.5}'
    - "// @input float grabZoneCm = 2 {\"hint\":\"Diameter of the needle's grab zone, cm (brief: about 2 cm)\", \"widget\":\"slider\", \"min\":1, \"max\":4, \"step\":0.25}"
    - '// @input vec4 needleColor = "{0.9,0.98,1,1}" {"hint":"Practice needle glow + thread colour before scoring", "widget":"color"}'
    - "// @input vec4 guideColor = \"{0.6,0.9,1,1}\" {\"hint\":\"Ghost trace colour (the attending's ideal arc)\", \"widget\":\"color\"}"
    - '// @input float toleranceMm = 1.5 {"hint":"Pass tolerance drawn as the band around the ideal arc, REAL mm (keep = SteadyHandsMain.stitchToleranceMm)"}'
    - '// @input float angleToleranceDeg = 15 {"hint":"Entry-angle tolerance drawn on the protractor, degrees (keep = SteadyHandsMain.angleToleranceDeg)"}'
    - "// @input float woundTopOffset = 0.5 {\"hint\":\"Pad top above the anchor's origin, cm (SuturePad: 0.5)\"}"
    - '// @input float tiltDeg = 18 {"hint":"Presentation tilt of the block toward the eye, degrees (shows the skin surface)", "widget":"slider", "min":0, "max":35, "step":1}'
    - '// @input float yawDeg = -14 {"hint":"Presentation yaw, degrees (negative shows the right side face)", "widget":"slider", "min":-35, "max":35, "step":1}'
    - '// @input float scanSec = 1.5 {"hint":"Seconds for the holographic scan-in (unfold)", "widget":"slider", "min":0.4, "max":3, "step":0.05}'
    - '// @input float foldSec = 0.7 {"hint":"Seconds to fold the cross-section away", "widget":"slider", "min":0.1, "max":2, "step":0.05}'
    - '// @ui {"widget":"group_end"}'
