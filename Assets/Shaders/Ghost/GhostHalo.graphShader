      TemplateVersionMinor: 2
      Title1: Halo Inflate
    Node10:
      DependencyIndex: 10
      LevelID: 101
      NodeCount: 0
      NodeType: 1
      Ports:
        Code:
          ClassType1: TEXT
          String: |-
            input_float level;
            input_vec3 haloColor;
            input_float haloIntensity;
            input_float haloPower;
            input_vec3 fadeCenter;
            input_float fadeNear;
            input_float fadeFar;
            input_vec4 clipPlane;
            output_vec4 result;
            
            void main()
            {
            	vec3 P = system.getSurfacePositionWorldSpace();
            	vec3 N = normalize(system.getSurfaceNormalWorldSpace());
            	vec3 V = normalize(system.getCameraPosition() - P);
            	float f = clamp(abs(dot(N, V)), 0.0, 1.0);
            	// Soft ring: zero at the shell's outer edge, peaks just inside it, fades toward the middle.
            	float g = pow(1.0 - f, haloPower) * smoothstep(0.0, 0.3, f);
            	float fade = 1.0 - smoothstep(fadeNear, fadeFar, distance(P, fadeCenter));
            	float keep = step(0.0, dot(clipPlane.xyz, P) + clipPlane.w);
            	float k = clamp(level, 0.0, 1.0) * fade * keep * haloIntensity;
            	result = vec4(haloColor * g * k, 0.0);
            }
        CustomCodeNodeAsset:
          ClassType1: REFUID
          String: ""
        Description:
          ClassType1: TEXT
          String: ""
        Examples:
          ItemIndex: 0
          ItemList: "Custom : Input/Output/Global Types : Extra Functions : Procedural Execution : Lighting Loop : System Built-In Values/Functions"
        ID:
          Variable: 0
        Locked:
          Variable: false
        Stage:
          ItemIndex: 1
          ItemList: "Vertex : Pixel"
        Title:
          String: Halo Glow
        UseExternalFile:
          Variable: false
        level:
          Connection0:
            NodeLevelID: 10
            PortID: Output
          Variable: 0.0
        haloColor:
          Connection0:
            NodeLevelID: 11
            PortID: Output
          Variable: [0.0, 0.0, 0.0]
        haloIntensity:
          Connection0:
            NodeLevelID: 12
            PortID: Output
          Variable: 0.0
        haloPower:
          Connection0:
            NodeLevelID: 13
            PortID: Output
          Variable: 0.0
        fadeCenter:
          Connection0:
            NodeLevelID: 15
            PortID: Output
          Variable: [0.0, 0.0, 0.0]
        fadeNear:
          Connection0:
            NodeLevelID: 16
            PortID: Output
          Variable: 0.0
        fadeFar:
          Connection0:
            NodeLevelID: 17
            PortID: Output
          Variable: 0.0
        clipPlane:
          Connection0:
            NodeLevelID: 18
            PortID: Output
          Variable: [0.0, 0.0, 0.0, 0.0]
        ngs_Height:
          Variable: 400
        ngs_Version:
          String: 0.1.0
        result:
          IOType: 1
          Variable: [0.0, 0.0, 0.0, 0.0]
