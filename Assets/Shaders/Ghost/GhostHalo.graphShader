    Node9:
      DependencyIndex: 9
      LevelID: 100
      NodeCount: 0
      NodeType: 1
      Ports:
        Code:
          ClassType1: TEXT
          String: |-
            input_float haloWidth;
            output_vec3 inflated;
            
            void main()
            {
            	vec3 P = system.getSurfacePositionWorldSpace();
            	vec3 N = normalize(system.getSurfaceNormalWorldSpace());
            	inflated = P + N * haloWidth;
            }
        CustomCodeNodeAsset:
          ClassType1: REFUID
          String: ""
        Description:
          ClassType1: TEXT
          String: ""
