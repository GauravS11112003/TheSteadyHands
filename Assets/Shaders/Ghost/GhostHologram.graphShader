    Node14:
      DependencyIndex: 14
      LevelID: 100
      NodeCount: 0
      NodeType: 1
      Ports:
        Code:
          ClassType1: TEXT
          String: |-
            input_float level;
            input_vec3 coreColor;
            input_vec3 rimColor;
            input_float interior;
            input_float rimPower;
            input_float rimIntensity;
            input_float edgeGlow;
            input_float specular;
            input_float shimmer;
            input_float opacity;
            input_vec3 fadeCenter;
            input_float fadeNear;
            input_float fadeFar;
            input_vec4 clipPlane;
            output_vec4 result;
            
            void main()
            {
            	vec3 P = system.getSurfacePositionWorldSpace();
            	vec3 N = normalize(system.getSurfaceNormalWorldSpace());
            	vec3 V = normalize(system.getCameraPosition() - P);
            	float facing = clamp(abs(dot(N, V)), 0.0, 1.0);
            	float edge = 1.0 - facing;
            	float fres = pow(edge, rimPower);
            	float soft = edge * edge;
            	float hot = pow(edge, 6.0);
            	float t = system.getTimeElapsed();
            	float lines = 0.5 + 0.5 * sin(P.y * 18.0 - t * 7.0);
            	lines = lines * lines * lines * lines;
            	float bandPos = fract(P.y * 0.06 - t * 0.45);
            	float band = 1.0 - abs(bandPos - 0.5) * 2.0;
            	band = band * band * band * band * band * band * band * band;
            	float grain = system.getRandomFloat(floor(P * 3.0) + vec3(floor(t * 14.0)));
            	float shim = 1.0 + shimmer * (0.45 * lines + 1.1 * band + 0.3 * (grain - 0.5));
            	vec3 L = normalize(vec3(0.25, 1.0, 0.55));
            	vec3 H = normalize(L + V);
            	float spec = pow(max(dot(N, H), 0.0), 40.0) * specular;
            	float spec2 = pow(max(dot(N, normalize(vec3(-0.6, 0.4, 0.7) + V)), 0.0), 24.0) * specular * 0.5;
            	float lambert = 0.45 + 0.55 * max(dot(N, L), 0.0);
            	vec3 col = coreColor * interior * lambert;
            	col += rimColor * (fres * rimIntensity + soft * edgeGlow);
            	col += vec3(1.0) * hot * edgeGlow * 0.8;
            	col += rimColor * (spec + spec2);
            	col *= shim;
            	float a = clamp(opacity * (interior * 2.0 + fres * 0.9 + soft * edgeGlow * 0.4), 0.0, 1.0);
            	float fade = 1.0 - smoothstep(fadeNear, fadeFar, distance(P, fadeCenter));
            	float keep = step(0.0, dot(clipPlane.xyz, P) + clipPlane.w);
            	float k = clamp(level, 0.0, 1.0) * fade * keep;
            	result = vec4(col * k, a * k);
            }
        CustomCodeNodeAsset:
          ClassType1: REFUID
          String: ""
        Description:
          ClassType1: TEXT
          String: ""
        Examples:
          ItemIndex: 0
          ItemList: "Custom : Input/Output/Global Types : Extra Functions : Procedural Execution : Lighting Loop : System Built-In Values/Functions"
        ID:
          Variable: 0
        Locked:
          Variable: false
        Stage:
          ItemIndex: 1
          ItemList: "Vertex : Pixel"
        Title:
          String: Ghost Hologram
        UseExternalFile:
          Variable: false
        level:
          Connection0:
            NodeLevelID: 10
            PortID: Output
          Variable: 0.0
        coreColor:
          Connection0:
            NodeLevelID: 11
            PortID: Output
          Variable: [0.0, 0.0, 0.0]
        rimColor:
          Connection0:
            NodeLevelID: 12
            PortID: Output
          Variable: [0.0, 0.0, 0.0]
        interior:
