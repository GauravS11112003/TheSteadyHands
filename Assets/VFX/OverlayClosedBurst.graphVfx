    Node12:
      DependencyIndex: 12
      LevelID: 102
      NodeCount: 0
      NodeType: 1
      Ports:
        Code:
          ClassType1: TEXT
          String: |
            void main()
            {
            	vec2 uv = system.getSurfaceUVCoord0() * 2.0 - 1.0;
            	float r = length(uv);
            	float m = exp(-r * r * 5.0) * (1.0 - smoothstep(0.75, 1.0, r));
            	float core = 1.0 - smoothstep(0.0, 0.35, r);
            	vec4 pc = system.getParticleColor();
            	vec3 col = mix(pc.rgb, vec3(1.0), core * 0.6);
            	float a = pc.a * m;
            	system.setPixelColor0(vec4(col * a, a * 0.45));
            }

        CustomCodeNodeAsset:
          ClassType1: REFUID
          String: ""
        Description:
          ClassType1: TEXT
          String: ""
        Examples:
          ItemIndex: 0
          ItemList: "Custom : System Built-In Values/Functions"
        ID:
          Variable: 102
        Locked:
          Variable: false
        ParticleIn:
          ClassType2: PARTICLE
          Connection0:
            NodeLevelID: 0
            PortID: ParticleOut
        ParticleOut:
          ClassType2: PARTICLE
          IOType: 1
        Stage:
          ItemIndex: 1
          ItemList: "Vertex : Pixel"
        Title:
          String: Burst Color
        UseExternalFile:
          Variable: false
        ngs_Height:
          Variable: 400
        ngs_Version:
          String: 0.1.0
      PositionX: -140
      PositionY: 1468
