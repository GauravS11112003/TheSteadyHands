    Node7:
      DependencyIndex: 7
      LevelID: 101
      NodeCount: 0
      NodeType: 1
      Ports:
        Code:
          ClassType1: TEXT
          String: |
            void main()
            {
            	float age = system.getParticleAgeRatio();
            	vec4 c = system.getParticleColor();
            	c.a = clamp(age / 0.06, 0.0, 1.0) * (1.0 - age) * (1.0 - age);
            	system.setParticleColor(c);
            	vec3 vel = system.getParticleVelocity();
            	system.setParticleForce(system.getParticleForce() - vel * 2.4 + vec3(0.0, -2.0, 0.0));
            }

        CustomCodeNodeAsset:
          ClassType1: REFUID
          String: ""
        Description:
          ClassType1: TEXT
