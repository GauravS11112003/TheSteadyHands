    Node4:
      DependencyIndex: 4
      LevelID: 100
      NodeCount: 0
      NodeType: 1
      Ports:
        Code:
          ClassType1: TEXT
          String: |
            void main()
            {
            	vec4 r = system.getParticleRandomVec4(true, true, false, 1.0);
            	vec4 q = system.getParticleRandomVec4(true, true, false, 7.0);
            	float x = mix(-3.2, 3.2, r.x);
            	float side = q.w < 0.5 ? -1.0 : 1.0;
            	system.setParticlePosition(vec3(x, 0.08, side * mix(0.05, 0.7, r.y)));
            	system.setParticleVelocity(vec3((q.x - 0.5) * 4.0, mix(5.0, 14.0, r.z), side * mix(0.5, 4.0, q.y)));
            	system.setParticleSize(mix(0.14, 0.34, q.z));
            	system.setParticleMass(1.0);
            	vec4 green = vec4(0.36, 1.0, 0.54, 1.0);
            	vec4 white = vec4(0.85, 1.0, 0.92, 1.0);
            	system.setParticleColor(mix(green, white, r.w * r.w));
            	system.setParticleLife(mix(0.8, 1.6, r.w));
            }

        CustomCodeNodeAsset:
          ClassType1: REFUID
          String: ""
        Description:
          ClassType1: TEXT
          String: ""
        Examples:
          ItemIndex: 0
          ItemList: "Custom : System Built-In Values/Functions"
        ID:
          Variable: 100
        Locked:
          Variable: false
        ParticleIn:
          ClassType2: PARTICLE
          Connection0:
            NodeLevelID: 61
            PortID: Particle
        ParticleOut:
          ClassType2: PARTICLE
          IOType: 1
        Stage:
          ItemIndex: 1
          ItemList: "Vertex : Pixel"
        Title:
          String: Burst Spawn
        UseExternalFile:
          Variable: false
        ngs_Height:
          Variable: 400
        ngs_Version:
          String: 0.1.0
      PositionX: -140
